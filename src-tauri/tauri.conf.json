{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcadia",
  "version": "2.1.0",
  "identifier": "com.arcadia.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "valerchikforever",
    "shortDescription": "Arcadia — единый лаунчер игр",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "category": "Game",
    "longDescription": "Единая библиотека игр из Steam, Epic, GOG, Heroic, Lutris, других лаунчеров и папок с торрентами: учёт времени, обложки, коллекции, оверлей с FPS и датчиками, zapret и VPN.",
    "linux": {
      "deb": {
        "section": "games"
      },
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}